# Compiled deliverables and model artifacts are binary.
# Without this, core.autocrlf=true on Windows can rewrite LF bytes
# inside PDFs on checkout and corrupt them.
*.pdf binary
*.pptx binary
*.pt binary
*.onnx binary
*.zip binary

# Keep the presentation media and checksummed support files byte-identical.
submission/RoadInsight_Demo_EN.mp4 binary
submission/RoadInsight_Demo_EN.srt -text
submission/presentation_support/* -text
submission/presentation_support/*.png binary
